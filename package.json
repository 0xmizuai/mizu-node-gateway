{
  "name": "metadata-migrator",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy:staging": "wrangler deploy --config wrangler.staging.toml",
    "start": "wrangler dev --config wrangler.local.toml --local",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "lint": "eslint 'src/**/*.{js,ts}' --quiet",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --quiet --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.2",
    "@cloudflare/workers-types": "^4.20250121.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^13.3.0",
    "prettier": "^2.8.8",
    "tsc-files": "^1.1.4",
    "typescript": "^5.5.2",
    "vitest": "2.0.5",
    "wrangler": "^3.107.3"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.4",
    "chanfana": "^2.6.3",
    "cloudflare": "link:@upstash/redis/cloudflare",
    "hono": "^4.6.18",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "tsc-files --noEmit",
      "git add"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write",
      "git add"
    ]
  },
  "overrides": {
    "tinypool": {
      "typescript-eslint": "$typescript-eslint",
      "eslint": "$eslint"
    }
  }
}
